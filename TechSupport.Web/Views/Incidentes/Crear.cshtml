@model CrearIncidenteViewModel
@{
    ViewData["Title"] = "Nuevo incidente";
}

<div class="page-header">
    <h1>Nuevo incidente</h1>
</div>

<form asp-action="Crear" method="post" class="card form-narrow">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <div class="field">
            <label asp-for="Titulo" class="label"></label>
            <input asp-for="Titulo" class="input" />
            <span asp-validation-for="Titulo" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Descripcion" class="label"></label>
            <textarea asp-for="Descripcion" class="input" rows="4"></textarea>
        </div>
        <div class="field">
            <label asp-for="Prioridad" class="label"></label>
            <select asp-for="Prioridad" class="input">
                <option value="Baja">Baja</option>
                <option value="Media">Media</option>
                <option value="Alta">Alta</option>
                <option value="Critica">Crítica</option>
            </select>
        </div>
        <div class="actions">
            <button type="submit" class="btn btn-default">Guardar</button>
            <a class="btn btn-outline" asp-action="Index">Cancelar</a>
        </div>
    </div>
</form>
