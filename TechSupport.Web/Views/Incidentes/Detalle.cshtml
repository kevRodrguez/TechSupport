@model IncidenteDto
@{
    ViewData["Title"] = Model.Titulo;
    var esAdmin = User.IsInRole("Administrador");
    var esTecnico = User.IsInRole("Tecnico");
}

<div class="page-header">
    <div>
        <h1>@Model.Titulo</h1>
        <div class="badges">
            <span class="@Etiquetas.Badge(Model.Estado)">@Etiquetas.Estado(Model.Estado)</span>
            <span class="@Etiquetas.Badge(Model.Prioridad)">@Etiquetas.Prioridad(Model.Prioridad)</span>
        </div>
    </div>
    <a class="btn btn-outline" asp-action="Index">Volver</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="meta">
            <dt>Descripción</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</dd>
            <dt>Reportado por</dt>
            <dd>@Model.ReportadoPor</dd>
            <dt>Técnico</dt>
            <dd>@(Model.Tecnico ?? "Sin asignar")</dd>
            <dt>Creación</dt>
            <dd>@Etiquetas.Fecha(Model.FechaCreacion)</dd>
            <dt>Resolución</dt>
            <dd>@(Model.FechaResolucion is null ? "—" : Etiquetas.Fecha(Model.FechaResolucion.Value))</dd>
        </dl>
    </div>
</div>

<div class="actions" style="margin-top: 16px;">
    @if (esAdmin && Model.Estado == "Pendiente")
    {
        <a class="btn btn-default" asp-action="Asignar" asp-route-id="@Model.Id">Asignar técnico</a>
    }
    @if (esAdmin || esTecnico)
    {
        <a class="btn btn-outline" asp-action="Estado" asp-route-id="@Model.Id">Cambiar estado</a>
    }
    @if (esAdmin)
    {
        <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar este incidente? Se pierden el título, la descripción, el técnico y las fechas.');">
            <button type="submit" class="btn btn-destructive">Eliminar</button>
        </form>
    }
</div>
