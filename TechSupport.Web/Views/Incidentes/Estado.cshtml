@model EstadoViewModel
@{
    ViewData["Title"] = "Cambiar estado";
    var siguiente = Etiquetas.SiguienteEstado(Model.EstadoActual);
}

<div class="page-header">
    <h1>Cambiar estado</h1>
</div>

<form asp-action="Estado" method="post" class="card form-narrow">
    <div class="card-body">
        <p class="muted">Incidente: <strong>@Model.Titulo</strong></p>
        <p style="margin: 12px 0 16px;">
            Estado actual: <span class="@Etiquetas.Badge(Model.EstadoActual)">@Etiquetas.Estado(Model.EstadoActual)</span>
        </p>
        <input type="hidden" asp-for="IncidenteId" />
        <input type="hidden" asp-for="Titulo" />
        <input type="hidden" asp-for="EstadoActual" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <div class="field">
            <label asp-for="Estado" class="label"></label>
            <select asp-for="Estado" class="input">
                <option value="">Seleccione un estado</option>
                @foreach (var estado in Etiquetas.Estados)
                {
                    <option value="@estado.Value">@estado.Label</option>
                }
            </select>
            <p class="hint">
                @if (siguiente is null && Model.EstadoActual == "Pendiente")
                {
                    <span>Pendiente solo pasa a Asignado al asignar un técnico. La API rechaza otro destino.</span>
                }
                else if (siguiente is null)
                {
                    <span>Un incidente cerrado no se reabre. La API rechaza el cambio aunque se envíe este formulario.</span>
                }
                else
                {
                    <span>El siguiente estado permitido es @Etiquetas.Estado(siguiente). La API rechaza saltos o retrocesos.</span>
                }
            </p>
        </div>
        <div class="actions">
            <button type="submit" class="btn btn-default">Guardar estado</button>
            <a class="btn btn-outline" asp-action="Detalle" asp-route-id="@Model.IncidenteId">Cancelar</a>
        </div>
    </div>
</form>
