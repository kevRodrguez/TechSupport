@model EstadoViewModel
@{
    ViewData["Title"] = "Cambiar estado";
    var siguiente = Etiquetas.SiguienteEstado(Model.EstadoActual);
}

<h1 class="h3 mb-3">Cambiar estado</h1>
<p>Incidente: <strong>@Model.Titulo</strong></p>
<p>Estado actual: <span class="badge @Etiquetas.Badge(Model.EstadoActual)">@Etiquetas.Estado(Model.EstadoActual)</span></p>

@if (siguiente is null)
{
    <div class="alert alert-secondary">
        @if (Model.EstadoActual == "Pendiente")
        {
            <span>Un incidente pendiente solo avanza cuando un administrador asigna un técnico.</span>
        }
        else
        {
            <span>Un incidente cerrado no se puede reabrir. Si el problema vuelve, cree uno nuevo.</span>
        }
    </div>
    <a class="btn btn-link" asp-action="Detalle" asp-route-id="@Model.IncidenteId">Volver</a>
}
else
{
    <form asp-action="Estado" method="post" class="col-lg-6">
        <input type="hidden" asp-for="IncidenteId" />
        <input type="hidden" asp-for="Titulo" />
        <input type="hidden" asp-for="EstadoActual" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" class="form-select">
                <option value="@siguiente">@Etiquetas.Estado(siguiente)</option>
            </select>
            <div class="form-text">La API rechaza saltos o retrocesos aunque se altere este formulario.</div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar estado</button>
        <a class="btn btn-link" asp-action="Detalle" asp-route-id="@Model.IncidenteId">Cancelar</a>
    </form>
}
