@model IReadOnlyList<IncidenteDto>
@{
    ViewData["Title"] = "Incidentes";
}

<div class="page-header">
    <h1>Incidentes</h1>
    <a class="btn btn-default" asp-action="Crear">Nuevo incidente</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert">No hay incidentes para mostrar con tu rol.</div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Reportado por</th>
                    <th>Técnico</th>
                    <th>Creación</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-action="Detalle" asp-route-id="@item.Id">@item.Titulo</a></td>
                        <td><span class="@Etiquetas.Badge(item.Prioridad)">@Etiquetas.Prioridad(item.Prioridad)</span></td>
                        <td><span class="@Etiquetas.Badge(item.Estado)">@Etiquetas.Estado(item.Estado)</span></td>
                        <td>@item.ReportadoPor</td>
                        <td>@(item.Tecnico ?? "Sin asignar")</td>
                        <td>@Etiquetas.Fecha(item.FechaCreacion)</td>
                        <td><a class="btn btn-outline btn-sm" asp-action="Detalle" asp-route-id="@item.Id">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
