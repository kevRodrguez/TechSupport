@model AsignarViewModel
@{
    ViewData["Title"] = "Asignar técnico";
}

<div class="page-header">
    <h1>Asignar técnico</h1>
</div>

<form asp-action="Asignar" method="post" class="card form-narrow">
    <div class="card-body">
        <p class="muted" style="margin-bottom: 16px;">Incidente: <strong>@Model.Titulo</strong></p>
        <input type="hidden" asp-for="IncidenteId" />
        <input type="hidden" asp-for="Titulo" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <div class="field">
            <label asp-for="TecnicoId" class="label"></label>
            <select asp-for="TecnicoId" class="input">
                <option value="">Seleccione un técnico</option>
                @foreach (var tecnico in Model.Tecnicos)
                {
                    <option value="@tecnico.Id">@tecnico.NombreUsuario</option>
                }
            </select>
            <span asp-validation-for="TecnicoId" class="field-error"></span>
            <p class="hint">Solo se puede asignar a un técnico, y solo si el incidente está pendiente.</p>
        </div>
        <div class="actions">
            <button type="submit" class="btn btn-default">Asignar</button>
            <a class="btn btn-outline" asp-action="Detalle" asp-route-id="@Model.IncidenteId">Cancelar</a>
        </div>
    </div>
</form>
