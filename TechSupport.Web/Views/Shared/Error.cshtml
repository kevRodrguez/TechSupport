@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-error">
    <h1>Ocurrió un error</h1>
    <p>No se pudo completar la solicitud en el sitio.</p>
</div>

@if (Model.ShowRequestId)
{
    <p class="muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}
