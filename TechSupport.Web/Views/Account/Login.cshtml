@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-wrap">
    <div class="card auth-card">
        <div class="card-body">
            <h1 class="card-title">Iniciar sesión</h1>
            <p class="muted" style="margin-bottom: 20px;">Usa una de las cuentas de prueba para entrar.</p>
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
                <div class="field">
                    <label asp-for="NombreUsuario" class="label"></label>
                    <input asp-for="NombreUsuario" class="input" autocomplete="username" />
                    <span asp-validation-for="NombreUsuario" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password" class="label"></label>
                    <input asp-for="Password" class="input" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <button type="submit" class="btn btn-default btn-block">Entrar</button>
            </form>
        </div>
    </div>
</div>
